def agrees (fraction : Int × Nat) (r : Nat) : Bool :=
  (fraction.2 % 101 != 0) && ((fraction.1 - (r: Int)*fraction.2) % 101 == 0)

/-- A signed scalar profile can cancel two independent linear readings. -/
theorem crossNull (a b c d e f : ℚ) :
    a*(b*f-c*e)+b*(c*d-a*f)+c*(a*e-b*d)=0 ∧
    d*(b*f-c*e)+e*(c*d-a*f)+f*(a*e-b*d)=0 := by
  constructor <;> ring

