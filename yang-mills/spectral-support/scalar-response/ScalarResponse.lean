/-- Differentiate an unnormalized insertion and its partition function. -/
theorem tilt (N Z : ℝ → ℝ) (b u v : ℝ)
    (hn : HasDerivAt N (-v) b) (hz : HasDerivAt Z (-u) b) (h : Z b ≠ 0) :
    HasDerivAt (fun x => N x / Z x) (-(v/Z b - (N b/Z b)*(u/Z b))) b := by
  convert hn.div hz h using 1
  field_simp
  ring

/-- Centering both factors under an action tilt gives their third cumulant. -/
theorem tiltCovariance (p q m a b k t : ℝ) :
    -(t-k*m) + (a-p*m)*q + p*(b-q*m)
      = -(t-k*m-a*q-b*p+2*p*q*m) := by ring

/-- Two explicit factors of the bare coupling are differentiated. -/
theorem radialDerivative (K : ℝ → ℝ) (b t : ℝ) (hk : HasDerivAt K (-t) b) :
    HasDerivAt (fun x => x^2*K x) (2*b*K b-b^2*t) b := by
  convert ((hasDerivAt_pow 2 b).mul hk) using 1
  simp
  ring

theorem integratedResponse (b k t : ℝ) :
    2*(b^2*k)-b*(2*b*k-b^2*t)=b^3*t := by ring

/-- At first order the integrated third insertion multiplies V₁ by three. -/
theorem firstRadialTerm (v₀ v₁ x : ℝ) :
    2*(v₀+x*v₁)+x*v₁=2*v₀+x*(3*v₁) := by ring

/-- Source response of a squared normalized triangle, avoiding square roots. -/
theorem relativeSquare (T A B C : ℝ → ℝ) (x t a b c : ℝ)
    (ht : HasDerivAt T t x) (ha : HasDerivAt A a x)
    (hb : HasDerivAt B b x) (hc : HasDerivAt C c x)
    (hT : T x ≠ 0) (hA : A x ≠ 0) (hB : B x ≠ 0) (hC : C x ≠ 0) :
    HasDerivAt (fun y => T y*T y/(A y*B y*C y))
      ((T x*T x/(A x*B x*C x))*(2*t/T x-a/A x-b/B x-c/C x)) x := by
  have nz : A x * B x * C x ≠ 0 := mul_ne_zero (mul_ne_zero hA hB) hC
  convert (ht.mul ht).div ((ha.mul hb).mul hc) nz using 1
  field_simp
  ring

/-- Independent Gaussian colors give 9 direct and 3 of each crossed contraction. -/
def wick (ij kl ik jl il jk : ℚ) : ℚ := 9*ij*kl+3*ik*jl+3*il*jk

theorem singleRadial (v : ℚ) : wick v v v v v v / 24 - v^2 = -(3/8)*v^2 := by
  unfold wick
  ring

/-- The improved circle action (1-cos y)+c(1-cos y)^2 has this
    three-color contribution after multiplication by minus the action. -/
theorem radialMatch (v : ℚ) :
    3*((1/24:ℚ)-(1/3)/4)*3*v^2 = -(3/8)*v^2 := by ring

theorem sphereAtUnit : ((6:ℚ)/24)*(3-18/6+15/6^2)=5/48 := by norm_num

def relative (t₀ t₁ a b c da db dc : ℚ) : ℚ :=
  t₁/t₀-(da/a+db/b+dc/c)/2

