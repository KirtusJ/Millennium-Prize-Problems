def central (k : Nat) : Nat := (2*k).factorial/(k.factorial*k.factorial)

theorem centralChoose (k : Nat) : Nat.choose (2*k) k=central k := by
  rw [Nat.choose_eq_factorial_div_factorial (show k≤2*k by omega)]
  simp [central, two_mul]

def scaledTerm (k : Nat) : Nat := (central k)^2 * 5^(32-2*k)
def sumOne : Nat := ((List.range 17).map scaledTerm).sum
def sumTwo : Nat := ((List.range 17).map (fun (k : Nat) => (2*k+1)*scaledTerm k)).sum

