/-- Algebra behind Schur monotonicity for two nested covariance projections. -/
theorem squaredIncrement (s t : ℝ) : (s+t)^2-s^2=t^2+2*s*t := by ring

/-- The graph energy which bounds a nonnegative symmetric covariance by its row sums. -/
theorem rowEnergy {ι : Type*} [Fintype ι] (K : ι → ι → ℝ) (v : ι → ℝ)
    (hs : ∀ i j, K i j = K j i) :
    (∑ i, ∑ j, K i j * (v i - v j)^2) =
      2*((∑ i, ∑ j, K i j*(v i)^2) - (∑ i, ∑ j, K i j*v i*v j)) := by
  have swap : (∑ i, ∑ j, K i j * (v j)^2) = ∑ i, ∑ j, K i j*(v i)^2 := by
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun i _ => by rw [hs i j]))
  simp_rw [show ∀ i j, K i j*(v i-v j)^2 =
      K i j*(v i)^2+K i j*(v j)^2-2*(K i j*v i*v j) from fun i j => by ring]
  simp only [sum_sub_distrib, sum_add_distrib, ← mul_sum]
  rw [swap]
  ring

theorem boundaryTrace (n : ℝ) :
    6*(3*n^2*(n+1)-n^3)-4*(3*n^2*(n+1)) = 6*n^2 := by ring

/-- Trace bound for the count of entries above a specified positive excess. -/
theorem countExcess {ι : Type*} [Fintype ι] (w : ι → ℝ) (s : Finset ι) (δ budget : ℝ)
    (hn : ∀ i, 0 ≤ w i) (h : ∀ i ∈ s, δ ≤ w i) (hb : ∑ i, w i ≤ budget) :
    (s.card : ℝ)*δ ≤ budget := by
  calc
    _ = ∑ _i ∈ s, δ := by simp
    _ ≤ ∑ i ∈ s, w i := Finset.sum_le_sum h
    _ ≤ ∑ i, w i := Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ s) (fun i _ _ => hn i)
    _ ≤ _ := hb

def denominator : Int := 1180392368175873615

/-- Schur products of real Gram kernels have a nonnegative quadratic form. -/
theorem gramProduct {ι α β : Type*} [Fintype ι] [Fintype α] [Fintype β]
    (X : ι → α → ℝ) (Y : ι → β → ℝ) (v : ι → ℝ) :
    0 ≤ ∑ i, ∑ j, (∑ a, X i a*X j a)*(∑ b, Y i b*Y j b)*v i*v j := by
  have expand (i j : ι) :
      (∑ a, X i a*X j a)*(∑ b, Y i b*Y j b)*v i*v j =
      ∑ a, ∑ b, (v i*X i a*Y i b)*(v j*X j a*Y j b) := by
    simp only [Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm (s := (univ : Finset β))]
    exact Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => by ring))
  simp_rw [expand]
  calc
    0 ≤ ∑ a, ∑ b, (∑ i, v i*X i a*Y i b)^2 :=
      Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => sq_nonneg _))
    _ = _ := by
      simp_rw [pow_two, Finset.sum_mul, Finset.mul_sum]
      let f := fun a b i j => (v i*X i a*Y i b)*(v j*X j a*Y j b)
      change (∑ a, ∑ b, ∑ i, ∑ j, f a b i j) = ∑ i, ∑ j, ∑ a, ∑ b, f a b i j
      calc
        _ = ∑ a, ∑ i, ∑ b, ∑ j, f a b i j := sum_congr rfl (fun _ _ => sum_comm)
        _ = ∑ i, ∑ a, ∑ b, ∑ j, f a b i j := sum_comm
        _ = ∑ i, ∑ a, ∑ j, ∑ b, f a b i j :=
          sum_congr rfl (fun _ _ => sum_congr rfl (fun _ _ => sum_comm))
        _ = _ := sum_congr rfl (fun _ _ => sum_comm)

def vertices : List Nat := List.range 64

def neighbors (u : Nat) : List Nat :=
  (if u/8>0 then [u-8] else []) ++ (if u/8<7 then [u+8] else []) ++
  (if u%8>0 then [u-1] else []) ++ (if u%8<7 then [u+1] else [])

def reps : Array Nat := #[0,1,2,3,9,10,11,18,19,27]

def faces : List (Nat × Nat) := vertices.flatMap fun u =>
  [(u,64)] ++ (if u/8<7 then [(u,u+8)] else []) ++ (if u%8<7 then [(u,u+1)] else [])

def outerWeights : Array Int := #[2,4,5,6, 4,9,14,17, 5,14,22,27, 6,17,27,32]
def innerWeights : Array Int := #[2,4,5,6, 3,7,11,13, 4,9,14,17, 4,10,16,19]

def weight (p : Nat × Nat) : Int := Id.run do
  let x := p.1/8
  let y := p.1%8
  if p.2=64 then return outerWeights[4*(min x (7-x))+min y (7-y)]!
  if p.2=p.1+8 then return innerWeights[4*(min x (6-x))+min y (7-y)]!
  return innerWeights[4*(min y (6-y))+min x (7-x)]!

def orbitRows : List ((Nat × Nat) × Nat) :=
  (reps.toList.map fun u => ((u,64),if u/8=u%8 then 4 else 8)) ++
  ((List.range 16).map fun i =>
    let u := 8*(i/4)+i%4
    ((u,u+8), if i/4=3 then 4 else 8))

def patchNorm : Int := (faces.map fun p => weight p ^ 2).sum

/-- Integer potential row solves b A = D h_p^T, with zero potential at ground. -/
def balanced (p : Nat × Nat) (b : Array Int) : Bool :=
  b.size == 65 && b[64]! == 0 && vertices.all fun u =>
    let ns := neighbors u
    let rhs := (if p.1=u then denominator else 0) - (if p.2=u then denominator else 0)
    ((ns.length: Int)+1)*b[u]! - (ns.map (fun v => b[v]!)).sum == rhs

def work (p : Nat × Nat) (m : Nat) (b : Array Int) : Int :=
  6*(m:Int)*weight p*(faces.map (fun q =>
    let k := (if p=q then denominator else 0)-b[q.1]!+b[q.2]!
    weight q*k^2)).sum

